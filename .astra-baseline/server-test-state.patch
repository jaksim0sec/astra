+const GROQ_LOG_DIR = path.join(__dirname, 'logs');
+const GROQ_LOG_FILE = path.join(GROQ_LOG_DIR, 'groq-debug.jsonl');
+
+fs.mkdirSync(GROQ_LOG_DIR, {recursive: true});
+
+function writeGroqLog(event, data = {}) {
+  try {
+    fs.appendFileSync(
+      GROQ_LOG_FILE,
+      JSON.stringify({
+        timestamp: new Date().toISOString(),
+        event,
+        ...data
+      }) + '\n',
+      'utf8'
+    );
+  } catch (error) {
+    console.error('[Groq log write failed]', error.message);
+  }
+}
 
