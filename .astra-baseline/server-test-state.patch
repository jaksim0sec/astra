+/* =========================================================
+   GROQ CACHE TEST
+========================================================= */
+
+app.get(
+  '/api/groq-cache-test',
+  async (req, res) => {
+    const apiKey = process.env.GROQ_API_KEY;
+
+    if (!apiKey) {
+      return res.status(500).json({
+        ok: false,
+        error: 'GROQ_API_KEY가 설정되지 않았습니다.'
+      });
+    }
+
+    const messages = [
+      {
+        role: 'system',
+        content: SYSTEM_PROMPT
+      },
+      {
+        role: 'user',
+        content: 'CACHE_TEST'
+      }
+    ];
+
+    const body = JSON.stringify({
+      model:
+        process.env.GROQ_MODEL ||
+        'openai/gpt-oss-120b',
+      temperature: 0.1,
+      messages,
+      response_format: {
+        type: 'json_schema',
+        json_schema: {
+          name: 'workflow_planner',
+          strict: true,
+          schema: PLANNER_SCHEMA
+        }
+      }
+    });
+
+    const results = [];
+
+    for (let attempt = 1; attempt <= 2; attempt++) {
+      const startedAt = Date.now();
+      let response;
+
+      try {
+        response = await fetch(
+          'https://api.groq.com/openai/v1/chat/completions',
+          {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+              'Authorization': `Bearer ${apiKey}`
+            },
+            body
+          }
+        );
+      } catch (error) {
+        results.push({
+          attempt,
+          error: error.message
+        });
+        break;
+      }
+
+      const elapsedMs =
+        Date.now() - startedAt;
+
+      const headers = {};
+
+      response.headers.forEach(
+        (value, key) => {
+          if (
+            key.startsWith('x-ratelimit-') ||
+            key.startsWith('x-groq-') ||
+            key === 'retry-after'
+          ) {
+            headers[key] = value;
+          }
+        }
+      );
+
+      const rawBody =
+        await response.text();
+
+      let payload = null;
+
+      try {
+        payload =
+          rawBody
+            ? JSON.parse(rawBody)
+            : null;
+      } catch {}
+
+      results.push({
+        attempt,
+        status: response.status,
+        elapsedMs,
+        headers,
+        usage: payload?.usage || null,
+        cachedTokens:
+          payload
+            ?.usage
+            ?.prompt_tokens_details
+            ?.cached_tokens ??
+          null,
+        body: rawBody
+      });
+
+      writeGroqLog(
+        'cache_test',
+        {
+          attempt,
+          elapsedMs,
+          status: response.status,
+          headers,
+          usage: payload?.usage || null,
+          body: rawBody,
+          identicalBody: true
+        }
+      );
+
+      if (
+        attempt === 1 &&
+        response.ok
+      ) {
+        await new Promise(
+          resolve =>
+            setTimeout(
+              resolve,
+              1500
+            )
+        );
+      }
+    }
+
+    return res.json({
+      ok: true,
+      messages,
+      results
+    });
+  }
+);
+
